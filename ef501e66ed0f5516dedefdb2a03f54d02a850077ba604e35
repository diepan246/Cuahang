<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Tiệm trà sữa cá nhân - Trà sữa thơm ngon, topping hấp dẫn.">
  <title>MilkTea House - Trà Sữa Nhà Làm</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #fff8f3;
      color: #3d2924;
      line-height: 1.6;
    }

    /* ================= HEADER ================= */

    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.96);
      box-shadow: 0 2px 15px rgba(0, 0, 0, 0.08);
    }

    .navbar {
      max-width: 1200px;
      margin: auto;
      padding: 15px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 26px;
      font-weight: 800;
      color: #b85c38;
      text-decoration: none;
    }

    .logo span {
      color: #e99b72;
    }

    nav ul {
      display: flex;
      list-style: none;
      gap: 28px;
    }

    nav a {
      text-decoration: none;
      color: #3d2924;
      font-weight: 600;
      transition: 0.3s;
    }

    nav a:hover {
      color: #c96b45;
    }

    .cart-button {
      border: none;
      background: #b85c38;
      color: white;
      padding: 10px 17px;
      border-radius: 25px;
      cursor: pointer;
      font-weight: bold;
      transition: 0.3s;
    }

    .cart-button:hover {
      background: #8f4228;
      transform: translateY(-2px);
    }

    /* ================= HERO ================= */

    .hero {
      min-height: 650px;
      display: flex;
      align-items: center;
      justify-content: center;
      background:
        linear-gradient(
          90deg,
          rgba(255, 248, 243, 0.98),
          rgba(255, 248, 243, 0.72)
        ),
        url("https://images.unsplash.com/photo-1558857563-b371033873b8?auto=format&fit=crop&w=1600&q=80")
        center/cover;
    }

    .hero-content {
      width: 1200px;
      max-width: 90%;
      padding: 60px 20px;
    }

    .hero-content h1 {
      font-size: clamp(42px, 6vw, 72px);
      max-width: 700px;
      line-height: 1.1;
      margin-bottom: 20px;
      color: #4b2e27;
    }

    .hero-content h1 span {
      color: #c96b45;
    }

    .hero-content p {
      max-width: 570px;
      font-size: 19px;
      margin-bottom: 30px;
      color: #624a43;
    }

    .hero-buttons {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 14px 25px;
      border-radius: 30px;
      text-decoration: none;
      font-weight: bold;
      transition: 0.3s;
    }

    .btn-primary {
      background: #b85c38;
      color: white;
    }

    .btn-primary:hover {
      background: #8f4228;
      transform: translateY(-3px);
    }

    .btn-secondary {
      border: 2px solid #b85c38;
      color: #b85c38;
    }

    .btn-secondary:hover {
      background: #b85c38;
      color: white;
    }

    /* ================= GENERAL ================= */

    section {
      padding: 80px 20px;
    }

    .container {
      max-width: 1200px;
      margin: auto;
    }

    .section-title {
      text-align: center;
      margin-bottom: 45px;
    }

    .section-title h2 {
      font-size: 38px;
      color: #4b2e27;
      margin-bottom: 8px;
    }

    .section-title p {
      color: #80665d;
    }

    /* ================= PRODUCTS ================= */

    .products {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .product-card {
      background: white;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 8px 25px rgba(90, 50, 30, 0.08);
      transition: 0.3s;
    }

    .product-card:hover {
      transform: translateY(-7px);
      box-shadow: 0 15px 35px rgba(90, 50, 30, 0.15);
    }

    .product-image {
      height: 250px;
      width: 100%;
      object-fit: cover;
    }

    .product-info {
      padding: 20px;
    }

    .product-info h3 {
      font-size: 21px;
      margin-bottom: 7px;
    }

    .product-info p {
      color: #80665d;
      font-size: 14px;
      margin-bottom: 15px;
    }

    .product-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .price {
      color: #b85c38;
      font-size: 20px;
      font-weight: bold;
    }

    .add-cart {
      border: none;
      background: #f3d2c3;
      color: #713b2b;
      padding: 9px 15px;
      border-radius: 20px;
      cursor: pointer;
      font-weight: bold;
    }

    .add-cart:hover {
      background: #b85c38;
      color: white;
    }

    /* ================= ABOUT ================= */

    .about {
      background: #f7e5db;
    }

    .about-content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      align-items: center;
    }

    .about-image {
      width: 100%;
      height: 430px;
      object-fit: cover;
      border-radius: 25px;
    }

    .about-text h2 {
      font-size: 38px;
      margin-bottom: 20px;
    }

    .about-text p {
      color: #695149;
      margin-bottom: 15px;
    }

    .features {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
      margin-top: 25px;
    }

    .feature {
      background: white;
      padding: 15px;
      border-radius: 12px;
    }

    .feature strong {
      display: block;
      color: #b85c38;
      margin-bottom: 4px;
    }

    /* ================= PROMOTION ================= */

    .promotion {
      background: #b85c38;
      color: white;
      text-align: center;
      border-radius: 25px;
      padding: 50px 25px;
    }

    .promotion h2 {
      font-size: 38px;
      margin-bottom: 10px;
    }

    .promotion p {
      margin-bottom: 25px;
    }

    .promotion .btn {
      background: white;
      color: #b85c38;
    }

    /* ================= CONTACT ================= */

    .contact-content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 35px;
    }

    .contact-info,
    .contact-form {
      background: white;
      padding: 30px;
      border-radius: 20px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.06);
    }

    .contact-info h3,
    .contact-form h3 {
      margin-bottom: 20px;
      font-size: 24px;
    }

    .contact-info p {
      margin-bottom: 12px;
      color: #695149;
    }

    .contact-form input,
    .contact-form textarea {
      width: 100%;
      padding: 13px;
      margin-bottom: 15px;
      border: 1px solid #e1d1ca;
      border-radius: 10px;
      outline: none;
      font-family: inherit;
    }

    .contact-form textarea {
      height: 120px;
      resize: vertical;
    }

    .contact-form button {
      width: 100%;
      border: none;
      background: #b85c38;
      color: white;
      padding: 14px;
      border-radius: 10px;
      font-weight: bold;
      cursor: pointer;
    }

    .contact-form button:hover {
      background: #8f4228;
    }

    /* ================= FOOTER ================= */

    footer {
      background: #3d2924;
      color: white;
      text-align: center;
      padding: 30px 20px;
    }

    footer p {
      color: #d7c1b8;
      margin-top: 5px;
    }

    /* ================= CART ================= */

    .cart-panel {
      position: fixed;
      top: 0;
      right: -420px;
      width: 400px;
      max-width: 90%;
      height: 100vh;
      background: white;
      z-index: 2000;
      padding: 25px;
      box-shadow: -5px 0 25px rgba(0,0,0,0.15);
      transition: 0.35s;
      display: flex;
      flex-direction: column;
    }

    .cart-panel.active {
      right: 0;
    }

    .cart-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 25px;
    }

    .close-cart {
      border: none;
      background: none;
      font-size: 25px;
      cursor: pointer;
    }

    #cart-items {
      flex: 1;
      overflow-y: auto;
    }

    .cart-item {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      padding: 12px 0;
      border-bottom: 1px solid #eee;
    }

    .cart-item strong {
      display: block;
    }

    .remove-item {
      border: none;
      background: #ffe3da;
      color: #a54125;
      padding: 5px 8px;
      border-radius: 6px;
      cursor: pointer;
    }

    .cart-total {
      border-top: 2px solid #eee;
      padding-top: 20px;
      margin-top: 15px;
    }

    .cart-total-row {
      display: flex;
      justify-content: space-between;
      font-size: 20px;
      font-weight: bold;
      margin-bottom: 15px;
    }

    .checkout {
      width: 100%;
      border: none;
      padding: 14px;
      border-radius: 10px;
      background: #b85c38;
      color: white;
      font-weight: bold;
      cursor: pointer;
    }

    .checkout:hover {
      background: #8f4228;
    }

    /* ================= RESPONSIVE ================= */

    @media (max-width: 900px) {
      .products {
        grid-template-columns: repeat(2, 1fr);
      }

      .about-content,
      .contact-content {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 650px) {
      nav ul {
        display: none;
      }

      .navbar {
        padding: 13px 15px;
      }

      .logo {
        font-size: 22px;
      }

      .hero {
        min-height: 570px;
      }

      .hero-content h1 {
        font-size: 43px;
      }

      .hero-content p {
        font-size: 16px;
      }

      section {
        padding: 60px 15px;
      }

      .products {
        grid-template-columns: 1fr;
      }

      .features {
        grid-template-columns: 1fr;
      }

      .section-title h2,
      .about-text h2,
      .promotion h2 {
        font-size: 30px;
      }
    }
  </style>
</head>

